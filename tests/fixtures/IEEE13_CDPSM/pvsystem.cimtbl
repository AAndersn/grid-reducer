# OpenDSS PVSystem -> PowerElectronicsConnection + PhotoVoltaicUnit on its bus: the snapshot dispatch at
# rated voltage, in the load sign (generation is negative p).
# Source table: PVSystem (records: 2)
# Mapping: cimhub_opendss/docs/CIMTBL_MAPPING.md#pvsystem

Profile = cim18v17

# derived: p = -(Pmpp x irradiance x %Pmpp, cut to fit kVA), 0 below %Cutout (pv_power); q = -kvar
Table PowerElectronicsConnection: mRID, name, node, phases, phaseConnection, ratedS (kVA), ratedU (kV), p (kW), q (kVAr), maxQ (kVAr), minQ (kVAr), maxIFault, normallyInService, BaseVoltage, EquipmentContainer=fdr_ieee13nodeckt
    # defaulted: pct_Pmpp=100.0, pct_Cutout=20.0, model=1, Vminpu=0.9, enabled=true
    pv_house,  House,  house, s1s2, Y, 5.0,   0.208, -4.0,   0.0, 5.0,   -5.0,   1.1111111111111112, true, bv_240v
    # defaulted: pct_Pmpp=100.0, conn=wye, pct_Cutout=20.0, model=1, Vminpu=0.9, enabled=true
    pv_school, School, 634,   ,     Y, 300.0, 0.48,  -240.0, 0.0, 300.0, -300.0, 1.1111111111111112, true, bv_480v

Table PhotoVoltaicUnit: mRID, maxP (kW), minP (kW), PowerElectronicsConnection, EquipmentContainer=fdr_ieee13nodeckt
    pv_house_unit,  5.0,   0.0, pv_house
    pv_school_unit, 300.0, 0.0, pv_school
